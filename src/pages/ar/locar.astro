---
import ArPageLayout from '../../layouts/ArPageLayout.astro';
import IntroPanel from '../../ar-engines/locar/components/IntroPanel.svelte';
import StatusOverlay from '../../ar-engines/locar/components/StatusOverlay.svelte';
import DebugPanel from '../../ar-engines/locar/components/DebugPanel.svelte';
import CorrectionControls from '../../ar-engines/locar/components/CorrectionControls.svelte';
---

<ArPageLayout title="水門 AR(Pattern A: LocAR)">
  <!--
    UIはすべてSvelteアイランド(IntroPanel等)が担当。AR のカメラ/レンダラ(canvas)・
    モデルは controller.ts が「ARを開始」タップ後に生成する(モバイルのカメラ/
    方位許可はユーザー操作が必要なため)。LocAR が <video> と <canvas> を body に
    差し込む。各アイランドは同じ src/ar-engines/locar/state.ts の store を共有する
    (client:only="svelte" はSSRを素通りするため、window/fetchへ即アクセスする
    IntroPanelに必須。他アイランドも状態を揃えるため統一している)。
  -->
  <IntroPanel client:only="svelte" />
  <StatusOverlay client:only="svelte" />
  <DebugPanel client:only="svelte" />
  <CorrectionControls client:only="svelte" />
</ArPageLayout>
