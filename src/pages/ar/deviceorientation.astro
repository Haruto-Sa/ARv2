---
import ArPageLayout from '../../layouts/ArPageLayout.astro';
import StagePanels from '../../ar-engines/deviceorientation/components/StagePanels.svelte';
import TrackingBanner from '../../ar-engines/deviceorientation/components/TrackingBanner.svelte';
import DebugOverlay from '../../ar-engines/deviceorientation/components/DebugOverlay.svelte';
---

<ArPageLayout title="水門 AR(Pattern C: DeviceOrientation)">
  <header class="top-bar">
    <div class="top-title">オンサイトAR — 水門(Pattern C)</div>
    <a class="chip" href="/">← ホーム</a>
  </header>

  <!--
    ステージ別UI(intro/gps-acquiring/coarse/aligning/anchored/error)は
    StagePanels.svelteが一括で扱う。バナーとデバッグオーバーレイは独立した
    アイランドだが、同じ src/ar-engines/deviceorientation/state.ts の store を
    共有する(3アイランドともclient:only="svelte" — 起動直後にwindow/fetchへ
    アクセスするためSSRを素通りする必要がある)。
  -->
  <StagePanels client:only="svelte" />
  <TrackingBanner client:only="svelte" />
  <DebugOverlay client:only="svelte" />
</ArPageLayout>

<style>
  body {
    margin: 0;
    overflow: hidden;
    color: #f6f7fb;
    background: #050a12;
  }

  .top-bar {
    position: fixed;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 10000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(10, 14, 24, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }

  .top-title {
    font-size: 14px;
    font-weight: 700;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
  }
</style>
