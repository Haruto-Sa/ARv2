---
import ArPageLayout from '../../layouts/ArPageLayout.astro';
import IntroPanel from '../../ar-engines/arjs/components/IntroPanel.svelte';
---

<ArPageLayout title="水門 AR(Pattern B: AR.js)">
  <!--
    紹介UIはIntroPanel.svelteが担当。<a-scene>(A-Frame + AR.js)は「ARを開始」
    タップ後にcontroller.tsが動的生成する(モバイルのカメラ/方位許可はユーザー
    操作が必要なため)。IntroPanelは起動直後にwindow/fetchへアクセスするため、
    SSR(ビルド時プリレンダー)を素通りするclient:onlyでマウントする。
  -->
  <IntroPanel client:only="svelte" />
</ArPageLayout>
