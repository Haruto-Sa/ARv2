---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// 体験メニュー。active なものだけリンクを持つ。soon はプレースホルダー(クリック不可)。
// 開発者向けの比較ページ・検証用地点・デバッグUIは公開版に出さない(docs/ar-spec.md §6)。
// 現地AR・床置きAR・3Dビューアは、仕様書の採用方式がまだ /ar/onsite・/ar/place・/viewer に
// 組み込まれるまで「準備中」として出す。
const experiences = [
  {
    icon: '📍',
    title: '現地AR',
    description: '水門の3Dモデルを実物大でその場に重ねて表示します。',
    status: 'soon' as const,
  },
  {
    icon: '🧩',
    title: '床置きAR',
    description: '床や机に縮小した3Dモデルを置いて、回したり拡大縮小したりできます。',
    status: 'soon' as const,
  },
  {
    icon: '🖥️',
    title: '3Dビューア',
    description: 'ARに対応していない端末でも、水門の3Dモデルを見られます。',
    status: 'soon' as const,
  },
  {
    icon: '🏠',
    title: '点群3D空間(Matterport)',
    description: '現地の点群スキャンをブラウザ上で歩き回れます。',
    status: 'soon' as const,
  },
  {
    icon: '🎥',
    title: '360度動画',
    description: '現地で撮影した360度映像を見られます。',
    status: 'soon' as const,
  },
  {
    icon: '🎮',
    title: '閉伊川3D世界',
    description: 'Unityで構築した閉伊川流域の3D空間を、WebGLでブラウザから探索できます。',
    status: 'active' as const,
    href: withBase('/unity/'),
  },
  {
    icon: '🪵',
    title: '流木コンテンツ',
    description: '拾い上げた流木を使ったコンテンツ。ネイティブアプリからWebGLへ移植中です。',
    status: 'soon' as const,
  },
];

// マーケー(横流れ)表示用に2セット連続で並べる。後半セットは aria-hidden でスクリーンリーダー・
// キーボードフォーカスから隠し、シームレスループ用の見た目だけの複製として扱う。
const experiencesLoop = [...experiences, ...experiences];

const steps = [
  { title: 'カメラ・位置情報・モーションセンサーを許可する', description: '開始時にブラウザが確認を求めます。すべて許可してください。' },
  { title: '体験したい機能を選ぶ', description: '下の「体験メニュー」から選びます。' },
  { title: 'スマートフォンをかざす', description: '屋外の見通しの良い場所で、画面越しに水門が重なって表示されます。' },
];
---

<BaseLayout title="閉伊川水門プロジェクト">
  <header class="site-header">
    <span class="site-brand">
      <svg class="site-mark" viewBox="0 0 24 24" aria-hidden="true">
        <clipPath id="site-mark-clip">
          <circle cx="12" cy="12" r="12" />
        </clipPath>
        <g clip-path="url(#site-mark-clip)">
          <rect width="24" height="24" fill="var(--water-soft)" />
          <path d="M-2 15 L6 6 L11 12 L15 5 L26 15 L26 26 L-2 26 Z" fill="var(--accent2)" />
          <path
            d="M-2 20 C5 15 9 23 15 18 C19 15 21 20 26 17 L26 26 L-2 26 Z"
            fill="var(--water)"
          />
        </g>
      </svg>
      <span class="site-title">閉伊川水門プロジェクト</span>
    </span>
    <nav class="site-nav">
      <a href="#menu">体験メニュー</a>
      <a href="#map">地図</a>
      <a href="#usage">使い方</a>
    </nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <canvas class="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-content">
        <span class="hero-icon" aria-hidden="true">🌊</span>
        <h1>閉伊川水門を、AR・3Dスキャン・映像で体験する</h1>
        <svg class="hero-underline" viewBox="0 0 160 12" aria-hidden="true">
          <path d="M2 8 C 30 2, 55 2, 80 7 S 130 12, 158 5" />
        </svg>
        <p class="lead">
          岩手県宮古市・閉伊川水門を、現地に行かなくても様々な方法で体験できるプロジェクトです。
          位置情報ARでは、水門の3Dモデルを実物大でその場に重ねて表示します。
        </p>
        <a class="btn-primary" href="#menu">体験メニューを見る</a>
      </div>

      <svg class="wave-divider" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,20 C300,60 900,-10 1200,30 L1200,60 L0,60 Z" />
      </svg>
    </section>

    <section id="menu" class="menu-section">
      <h2>体験メニュー</h2>
      <p class="section-note">ドラッグ・スクロールで他のメニューをすぐに見られます。</p>
      <div class="menu-flow">
        <div class="menu-track">
          {
            experiencesLoop.map((item, i) => {
              const dup = i >= experiences.length;
              return item.status === 'active' ? (
                <a
                  class="menu-card"
                  href={item.href}
                  aria-hidden={dup ? 'true' : undefined}
                  tabindex={dup ? -1 : undefined}
                >
                  <div class="menu-icon">{item.icon}</div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <span class="menu-arrow">→</span>
                </a>
              ) : (
                <div class="menu-card soon" aria-hidden={dup ? 'true' : undefined}>
                  <div class="menu-icon">{item.icon}</div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <span class="badge">近日公開</span>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="map" class="map-section">
      <h2>水門地点マップ</h2>
      <p class="section-note">現地AR・床置きARの対象地点です。</p>
      <div id="locations-map"></div>
    </section>

    <section id="usage" class="usage-section">
      <h2>使い方</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-number">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <a href="https://github.com/Haruto-Sa/ARv2" target="_blank" rel="noopener">GitHub</a>
    </div>
  </footer>

  <script>
    import { loadLocationCatalog } from '../lib/config/locationConfig';
    import { withBase } from '../lib/paths';
    import { initWaterCanvas } from '../lib/water-shader';
    import * as L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    const heroCanvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
    if (heroCanvas) initWaterCanvas(heroCanvas);

    const DEFAULT_PIN_COLOR = '#e0341f';

    function pinIcon(color: string) {
      return L.divIcon({
        className: 'ar-map-pin',
        html: `<svg width="26" height="34" viewBox="0 0 26 34" xmlns="http://www.w3.org/2000/svg">
          <path d="M13 0C5.8 0 0 5.8 0 13c0 9.5 13 21 13 21s13-11.5 13-21C26 5.8 20.2 0 13 0z" fill="${color}"/>
          <circle cx="13" cy="13" r="5" fill="#fff"/>
        </svg>`,
        iconSize: [26, 34],
        iconAnchor: [13, 34],
        popupAnchor: [0, -30],
      });
    }

    async function initLocationsMap() {
      const mapEl = document.getElementById('locations-map');
      if (!mapEl) return;

      const map = L.map('locations-map', { zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      try {
        const catalog = await loadLocationCatalog(withBase('/config/locations/index.json'));
        const latlngs: [number, number][] = [];
        for (const loc of catalog) {
          latlngs.push([loc.latitude, loc.longitude]);
          const icon = loc.icon || '📍';
          L.marker([loc.latitude, loc.longitude], { icon: pinIcon(loc.color || DEFAULT_PIN_COLOR) })
            .addTo(map)
            .bindPopup(`${icon} ${loc.name}`);
        }
        if (latlngs.length) {
          map.fitBounds(latlngs, { padding: [20, 20] });
        } else {
          map.setView([39.7021, 141.1544], 14);
        }
      } catch (e) {
        console.warn('ロケーション一覧の読み込みに失敗しました', e);
        map.setView([39.7021, 141.1544], 14);
      }
    }

    initLocationsMap();

    // ヘッダーの背景をスクロール量に応じて濃くする(視認性のための機能的な変化)。
    const header = document.querySelector('.site-header');
    window.addEventListener(
      'scroll',
      () => {
        header?.classList.toggle('scrolled', window.scrollY > 8);
      },
      { passive: true }
    );

    // ナビの現在地ハイライト: 表示中のセクションに対応するリンクへ .active を付ける。
    const navLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]').forEach((a) => {
      navLinks.set(a.getAttribute('href')!.slice(1), a);
    });
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = navLinks.get(entry.target.id);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    navLinks.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    // 体験メニュー(横流れ帯)全体を、初回表示時だけ軽くフェードイン+スライドさせる。
    const menuFlow = document.querySelector('.menu-flow');
    if (menuFlow) {
      const flowObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              flowObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      // pre-reveal はJSがここで付与したときだけ効く(CSS側の既定は常に表示)。
      menuFlow.classList.add('pre-reveal');
      flowObserver.observe(menuFlow);
    }

    // 体験メニューのオート横流れ。ネイティブの scrollLeft を直接動かすため、ユーザーの
    // ドラッグ/スクロール操作(同じ scrollLeft を操作する)といつでも共存できる。
    setupMenuFlow(menuFlow as HTMLElement | null);

    function setupMenuFlow(flow: HTMLElement | null): void {
      const track = flow?.querySelector<HTMLElement>('.menu-track');
      if (!flow || !track) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const AUTO_SPEED = 24; // px/秒
      let paused = false;
      let dragging = false;
      let moved = false;
      let suppressClick = false;
      let dragStartX = 0;
      let dragStartScrollLeft = 0;
      let last = performance.now();

      function loopWidth(): number {
        return track!.scrollWidth / 2;
      }

      function wrapScroll(): void {
        const half = loopWidth();
        if (half <= 0) return;
        if (flow!.scrollLeft >= half) flow!.scrollLeft -= half;
        else if (flow!.scrollLeft < 0) flow!.scrollLeft += half;
      }

      flow.addEventListener('scroll', wrapScroll, { passive: true });

      // ホバー中・ドラッグ中は即座に止まり、外れた瞬間に再び流れ出す(遅延なし)。
      flow.addEventListener('pointerenter', () => {
        paused = true;
      });
      flow.addEventListener('pointerleave', () => {
        paused = false;
        dragging = false;
        flow!.style.cursor = 'grab';
      });

      flow.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        moved = false;
        dragStartX = e.clientX;
        dragStartScrollLeft = flow!.scrollLeft;
        flow!.style.cursor = 'grabbing';
        flow!.setPointerCapture(e.pointerId);
      });
      flow.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - dragStartX;
        if (Math.abs(dx) > 4) moved = true;
        flow!.scrollLeft = dragStartScrollLeft - dx;
        e.preventDefault();
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        flow!.style.cursor = 'grab';
        if (moved) {
          // ドラッグ後に指/マウスを離した位置でカードへの誤クリック(意図しない遷移)を防ぐ。
          suppressClick = true;
          setTimeout(() => {
            suppressClick = false;
          }, 60);
        }
      };
      flow.addEventListener('pointerup', endDrag);
      flow.addEventListener('pointercancel', endDrag);
      flow.addEventListener(
        'click',
        (e) => {
          if (suppressClick) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
      flow.addEventListener('dragstart', (e) => e.preventDefault());

      if (!prefersReducedMotion) {
        const tick = (now: number) => {
          const dt = Math.min(80, now - last);
          last = now;
          if (!paused && !dragging) {
            flow!.scrollLeft += (AUTO_SPEED * dt) / 1000;
            wrapScroll();
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }
  </script>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .menu-flow,
    .menu-flow.pre-reveal,
    .menu-arrow,
    .btn-primary,
    .site-header,
    .hero-icon {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .menu-card[aria-hidden='true'] {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    max-width: 960px;
    margin: 0 auto;
    padding: 16px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-soft), background-color 0.3s var(--ease-soft);
  }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--border-soft);
  }
  .site-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-mark {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .site-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .site-nav {
    display: flex;
    gap: 18px;
  }
  .site-nav a {
    color: var(--text-soft);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.25s var(--ease-soft);
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .site-nav a.active {
    color: var(--accent);
    font-weight: 700;
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .hero {
    position: relative;
    margin: 0 -16px 56px;
    padding: 40px 16px 72px;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    touch-action: pan-y;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-icon {
    display: inline-block;
    font-size: 40px;
    margin-bottom: 8px;
    animation: float 5s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .wave-divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 40px;
    display: block;
    z-index: 1;
  }
  .wave-divider path {
    fill: var(--bg);
  }
  h1 {
    margin: 0 0 12px;
    font-size: 28px;
    line-height: 1.45;
    color: var(--text);
    max-width: 16em;
  }
  .hero-underline {
    display: block;
    width: 130px;
    height: 10px;
    margin: 0 0 16px;
  }
  .hero-underline path {
    fill: none;
    stroke: var(--water);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .lead {
    margin: 0 0 24px;
    max-width: 40em;
    color: var(--text-soft);
    line-height: 1.8;
  }
  .btn-primary {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent) 70%, transparent);
    transition: background-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
  }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, black);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -8px color-mix(in srgb, var(--accent) 75%, transparent);
  }

  section {
    margin-top: 48px;
    scroll-margin-top: 72px;
  }
  section h2 {
    margin: 0 0 6px;
    font-size: 19px;
    color: var(--text);
  }
  .section-note {
    margin: 0 0 16px;
    font-size: 14px;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .menu-flow {
    position: relative;
    margin-top: 18px;
    padding: 8px 0;
    border-radius: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: none;
    transition: opacity 0.6s var(--ease-soft), transform 0.6s var(--ease-soft);
  }
  .menu-flow::-webkit-scrollbar {
    display: none;
  }
  /* pre-reveal はJSが付与したときだけ効く。JS未実行時は常に表示された状態が既定。 */
  .menu-flow.pre-reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .menu-flow.pre-reveal.visible {
    opacity: 1;
    transform: none;
  }
  .menu-track {
    display: flex;
    gap: 14px;
    width: max-content;
  }
  .menu-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 0 0 240px;
    padding: 18px;
    border-radius: 18px;
    border: none;
    background: var(--surface);
    box-shadow: 0 6px 18px -10px rgba(22, 50, 74, 0.16);
    color: inherit;
    text-decoration: none;
    position: relative;
    transition: box-shadow 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .menu-card.soon {
    opacity: 0.6;
  }
  a.menu-card:hover {
    box-shadow: 0 14px 28px -12px rgba(22, 50, 74, 0.22);
    transform: translateY(-3px);
  }
  .menu-icon {
    font-size: 26px;
  }
  .menu-card h3 {
    margin: 0;
    font-size: 15px;
    color: var(--text);
  }
  .menu-card p {
    margin: 0;
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.5;
  }
  .menu-arrow {
    position: absolute;
    right: 16px;
    bottom: 14px;
    color: var(--accent);
    opacity: 0.6;
    font-size: 14px;
    transition: opacity 0.25s var(--ease-soft), transform 0.25s var(--ease-soft);
  }
  a.menu-card:hover .menu-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  .badge {
    align-self: flex-start;
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent2) 18%, var(--surface));
    color: color-mix(in srgb, var(--accent2) 70%, var(--text));
    font-size: 11px;
    font-weight: 700;
  }

  #locations-map {
    width: 100%;
    height: 320px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 6px 18px -10px rgba(22, 50, 74, 0.16);
  }

  .steps {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .step-number {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
  }
  .steps h3 {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--text);
  }
  .steps p {
    margin: 0;
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .site-footer {
    margin-top: 48px;
    padding: 24px 16px;
    background: var(--bg-soft);
    border-top: 1px solid var(--border-soft);
  }
  .site-footer-inner {
    max-width: 960px;
    margin: 0 auto;
    font-size: 13px;
  }
  .site-footer a {
    color: var(--text-soft);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.25s var(--ease-soft);
  }
  .site-footer a:hover {
    opacity: 1;
  }
</style>
