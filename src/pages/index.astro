---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// 体験メニュー。active なものだけリンクを持つ。soon はプレースホルダー(クリック不可)。
// 開発者向けの比較ページ・検証用地点・デバッグUIは公開版に出さない(docs/ar-spec.md §6)。
// ユーザー指定の6要素(現地AR・床置きAR・水門3Dシミュレーション・小本川流木捕捉工シミュレーション・
// Matterport・360度動画)は追加・削除せずそのまま維持する。3Dビューアはこの6要素とは別に、
// AR非対応端末向けの既存の代替機能として残している(docs/ar-spec.md §3.1)。
// 現地AR(実物大を実際の水門に重ねるAR)は、まだ採用方式が未確定で /ar/onsite が未実装のため soon。
// 「水門3Dシミュレーション」(/heigawa/)と「小本川流木捕捉工シミュレーション」(/unity/)は
// 別々のUnity WebGLビルドで、別々の体験として扱う(過去に1つに混同されていた)。
const experiences = [
  {
    icon: '📍',
    title: '現地AR',
    description: '実物大の水門モデルを、実際の水門の前で重ねて表示します。採用方式を検証中です。',
    status: 'soon' as const,
  },
  {
    icon: '🧩',
    title: '床置きAR',
    description: 'テーブルや床などの平面を検出し、縮小した水門モデルを置いて、まわりから眺められます。',
    status: 'active' as const,
    href: withBase('/ar/place'),
    image: withBase('/images/menu/place-ar.jpg'),
  },
  {
    icon: '🖥️',
    title: '3Dビューア',
    description: 'ARに対応していない端末でも、水門の3Dモデルを見られます。',
    status: 'active' as const,
    href: withBase('/viewer'),
    image: withBase('/images/menu/viewer.jpg'),
  },
  {
    icon: '🌊',
    title: '水門3Dシミュレーション',
    description: '閉伊川水門を実際の地形・まち並みとともにUnityで再現。警報発生時に水門が自動で閉まり、まちへの浸水がどう変わるかを3Dで確かめられます。',
    status: 'active' as const,
    href: withBase('/heigawa/'),
    image: withBase('/images/menu/heigawa-unity.jpg'),
  },
  {
    icon: '🪵',
    title: '小本川流木捕捉工シミュレーション',
    description: '流木を受け止める捕捉工を、小本川に見立てた川に配置して、水位や流木の変化を確かめられます。',
    status: 'active' as const,
    href: withBase('/unity/'),
    image: withBase('/images/menu/driftwood-unity.jpg'),
  },
  {
    icon: '🏠',
    title: '点群3D空間(Matterport)',
    description: '現地の点群スキャンを、埋め込みビューでそのまま歩き回れます。',
    status: 'active' as const,
    href: withBase('/matterport/'),
    image: withBase('/images/menu/matterport.jpg'),
  },
  {
    icon: '🎥',
    title: '360度動画',
    description: '現地で撮影した360度映像を見られます。',
    status: 'soon' as const,
  },
];

// マーケー(横流れ)表示用に2セット連続で並べる。後半セットは aria-hidden でスクリーンリーダー・
// キーボードフォーカスから隠し、シームレスループ用の見た目だけの複製として扱う。
const experiencesLoop = [...experiences, ...experiences];

const steps = [
  { title: 'カメラ・位置情報・モーションセンサーを許可する', description: '開始時にブラウザが確認を求めます。すべて許可してください。' },
  { title: '体験したい機能を選ぶ', description: '下の「体験メニュー」から選びます。' },
  { title: 'スマートフォンをかざす', description: '屋外の見通しの良い場所で、画面越しに水門が重なって表示されます。' },
];
---

<BaseLayout title="閉伊川水門プロジェクト">
  <header class="site-header">
    <span class="site-brand">
      <svg class="site-mark" viewBox="0 0 24 24" aria-hidden="true">
        <clipPath id="site-mark-clip">
          <circle cx="12" cy="12" r="12" />
        </clipPath>
        <g clip-path="url(#site-mark-clip)">
          <rect width="24" height="24" fill="var(--water-soft)" />
          <path d="M-2 15 L6 6 L11 12 L15 5 L26 15 L26 26 L-2 26 Z" fill="var(--accent2)" />
          <path
            d="M-2 20 C5 15 9 23 15 18 C19 15 21 20 26 17 L26 26 L-2 26 Z"
            fill="var(--water)"
          />
        </g>
      </svg>
      <span class="site-title">閉伊川水門プロジェクト</span>
    </span>
    <nav class="site-nav">
      <a href="#menu">体験メニュー</a>
      <a href="#map">地図</a>
      <a href="#usage">使い方</a>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <canvas class="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-content">
        <span class="hero-icon" aria-hidden="true">🌊</span>
        <h1>宮古市の水害対策を、AR・3Dで見て、学ぶ。</h1>
        <svg class="hero-underline" viewBox="0 0 160 12" aria-hidden="true">
          <path d="M2 8 C 30 2, 55 2, 80 7 S 130 12, 158 5" />
        </svg>
        <p class="lead">
          岩手県宮古市では、水害から暮らしを守るために、水門の整備や流木をせき止める仕組みづくりが進められています。
          現地に行かなくても、AR・3Dスキャン・映像でその取り組みに触れながら、防災をデジタルで学べるプロジェクトです。
        </p>
        <a class="btn-primary" href="#menu">体験メニューを見る</a>
      </div>

      <svg class="wave-divider" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,20 C300,60 900,-10 1200,30 L1200,60 L0,60 Z" />
      </svg>
    </section>

    <section id="menu" class="menu-section">
      <h2>体験メニュー</h2>
      <p class="section-note">ドラッグ・スクロールで他のメニューをすぐに見られます。</p>
      <div class="menu-flow">
        <div class="menu-track">
          {
            experiencesLoop.map((item, i) => {
              const dup = i >= experiences.length;
              return item.status === 'active' ? (
                <a
                  class={`menu-card${item.image ? ' has-image' : ''}`}
                  href={item.href}
                  aria-hidden={dup ? 'true' : undefined}
                  tabindex={dup ? -1 : undefined}
                  style={item.image ? `--card-image: url(${item.image})` : undefined}
                >
                  {!item.image && <div class="menu-icon">{item.icon}</div>}
                  <div class="menu-card-text">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                  <span class="menu-arrow">→</span>
                </a>
              ) : (
                <div class="menu-card soon" aria-hidden={dup ? 'true' : undefined}>
                  <div class="menu-icon">{item.icon}</div>
                  <div class="menu-card-text">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                  <span class="badge">近日公開</span>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="map" class="map-section reveal">
      <h2>水門地点マップ</h2>
      <p class="section-note">現地AR・床置きARの対象地点です。</p>
      <div id="locations-map"></div>
    </section>

    <section id="usage" class="usage-section reveal">
      <h2>使い方</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-number">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <a href="https://github.com/Haruto-Sa/ARv2" target="_blank" rel="noopener">GitHub</a>
    </div>
  </footer>

  <script>
    import { loadLocationCatalog, loadLocationConfig } from '../lib/config/locationConfig';
    import { withBase } from '../lib/paths';
    import { initWaterCanvas } from '../lib/water-shader';
    import * as L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    const heroCanvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
    if (heroCanvas) initWaterCanvas(heroCanvas);

    const DEFAULT_PIN_COLOR = '#e0341f';
    const VERIFICATION_PIN_COLOR = '#a3471f';
    const CURRENT_LOCATION_PIN_COLOR = '#1f7a3d';

    function pinIcon(color: string) {
      return L.divIcon({
        className: 'ar-map-pin',
        html: `<svg width="26" height="34" viewBox="0 0 26 34" xmlns="http://www.w3.org/2000/svg">
          <path d="M13 0C5.8 0 0 5.8 0 13c0 9.5 13 21 13 21s13-11.5 13-21C26 5.8 20.2 0 13 0z" fill="${color}"/>
          <circle cx="13" cy="13" r="5" fill="#fff"/>
        </svg>`,
        iconSize: [26, 34],
        iconAnchor: [13, 34],
        popupAnchor: [0, -30],
      });
    }

    async function initLocationsMap() {
      const mapEl = document.getElementById('locations-map');
      if (!mapEl) return;

      const map = L.map('locations-map', { zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      try {
        const catalog = await loadLocationCatalog(withBase('/config/locations/index.json'));
        const latlngs: [number, number][] = [];
        for (const loc of catalog) {
          // 第二地域連携棟は検証用。後日オーナーが手動で削除予定。本番ビルドではlab-*接頭辞により自動的に除外される。
          const isVerification = loc.id.startsWith('lab-');
          let lat = loc.latitude;
          let lon = loc.longitude;
          if (isVerification) {
            try {
              const { config } = await loadLocationConfig(withBase(`/config/locations/${loc.id}.json`));
              if (config.latitude === null || config.longitude === null) continue;
              lat = config.latitude;
              lon = config.longitude;
            } catch {
              continue; // 本番ビルドでは除外済みのため404になる。想定内なので静かにスキップする。
            }
          }
          if (typeof lat !== 'number' || typeof lon !== 'number') continue;
          latlngs.push([lat, lon]);
          const icon = loc.icon || (isVerification ? '📍' : '🚪');
          const color = isVerification ? VERIFICATION_PIN_COLOR : loc.color || DEFAULT_PIN_COLOR;
          L.marker([lat, lon], { icon: pinIcon(color) })
            .addTo(map)
            .bindPopup(`${icon} ${loc.name}`);
        }
        if (latlngs.length) {
          map.fitBounds(latlngs, { padding: [20, 20], maxZoom: 15 });
        } else {
          map.setView([39.7021, 141.1544], 14);
        }

        // 現在地は任意・非ブロッキングで追加する。許可が無い/APIが無い場合は何もしない(静かに諦める)。
        if ('geolocation' in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              L.marker([pos.coords.latitude, pos.coords.longitude], { icon: pinIcon(CURRENT_LOCATION_PIN_COLOR) })
                .addTo(map)
                .bindPopup('📍 現在地');
            },
            () => {},
            { maximumAge: 60_000, timeout: 8000 }
          );
        }
      } catch (e) {
        console.warn('ロケーション一覧の読み込みに失敗しました', e);
        map.setView([39.7021, 141.1544], 14);
      }
    }

    initLocationsMap();

    // ヘッダーの背景をスクロール量に応じて濃くする(視認性のための機能的な変化)。
    const header = document.querySelector('.site-header');
    window.addEventListener(
      'scroll',
      () => {
        header?.classList.toggle('scrolled', window.scrollY > 8);
      },
      { passive: true }
    );

    // ナビの現在地ハイライト: 表示中のセクションに対応するリンクへ .active を付け、
    // 下線(.nav-indicator)をそのリンクの位置・幅へスライドさせる。
    const navLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]').forEach((a) => {
      navLinks.set(a.getAttribute('href')!.slice(1), a);
    });
    const navIndicator = document.querySelector<HTMLElement>('.nav-indicator');
    function moveNavIndicator(link: HTMLAnchorElement): void {
      if (!navIndicator) return;
      navIndicator.style.width = `${link.offsetWidth}px`;
      navIndicator.style.transform = `translateX(${link.offsetLeft}px)`;
      navIndicator.classList.add('visible');
    }
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = navLinks.get(entry.target.id);
          if (!link) continue;
          link.classList.toggle('active', entry.isIntersecting);
          if (entry.isIntersecting) moveNavIndicator(link);
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    navLinks.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    // 体験メニュー(横流れ帯)全体を、初回表示時だけ軽くフェードイン+スライドさせる。
    const menuFlow = document.querySelector('.menu-flow');
    if (menuFlow) {
      const flowObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              flowObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      // pre-reveal はJSがここで付与したときだけ効く(CSS側の既定は常に表示)。
      menuFlow.classList.add('pre-reveal');
      flowObserver.observe(menuFlow);
    }

    // 地図・使い方セクションも、初回スクロールで同様にフェードイン。
    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => {
      el.classList.add('pre-reveal');
      revealObserver.observe(el);
    });

    // 体験メニューのオート横流れ。ネイティブの scrollLeft を直接動かすため、ユーザーの
    // ドラッグ/スクロール操作(同じ scrollLeft を操作する)といつでも共存できる。
    setupMenuFlow(menuFlow as HTMLElement | null);

    function setupMenuFlow(flow: HTMLElement | null): void {
      const track = flow?.querySelector<HTMLElement>('.menu-track');
      if (!flow || !track) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const AUTO_SPEED = 24; // px/秒
      let paused = false;
      let dragging = false;
      let moved = false;
      let suppressClick = false;
      let dragStartX = 0;
      let dragStartScrollLeft = 0;
      let last = performance.now();

      function loopWidth(): number {
        return track!.scrollWidth / 2;
      }

      function wrapScroll(): void {
        const half = loopWidth();
        if (half <= 0) return;
        if (flow!.scrollLeft >= half) flow!.scrollLeft -= half;
        else if (flow!.scrollLeft < 0) flow!.scrollLeft += half;
      }

      flow.addEventListener('scroll', wrapScroll, { passive: true });

      // ホバー中・ドラッグ中は即座に止まり、外れた瞬間に再び流れ出す(遅延なし)。
      flow.addEventListener('pointerenter', () => {
        paused = true;
      });
      flow.addEventListener('pointerleave', () => {
        paused = false;
        dragging = false;
        flow!.style.cursor = 'grab';
      });

      flow.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        moved = false;
        dragStartX = e.clientX;
        dragStartScrollLeft = flow!.scrollLeft;
        flow!.style.cursor = 'grabbing';
        flow!.setPointerCapture(e.pointerId);
      });
      flow.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - dragStartX;
        if (Math.abs(dx) > 4) moved = true;
        flow!.scrollLeft = dragStartScrollLeft - dx;
        e.preventDefault();
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        flow!.style.cursor = 'grab';
        if (moved) {
          // ドラッグ後に指/マウスを離した位置でカードへの誤クリック(意図しない遷移)を防ぐ。
          suppressClick = true;
          setTimeout(() => {
            suppressClick = false;
          }, 60);
        }
      };
      flow.addEventListener('pointerup', endDrag);
      flow.addEventListener('pointercancel', endDrag);
      flow.addEventListener(
        'click',
        (e) => {
          if (suppressClick) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
      flow.addEventListener('dragstart', (e) => e.preventDefault());

      if (!prefersReducedMotion) {
        const tick = (now: number) => {
          const dt = Math.min(80, now - last);
          last = now;
          if (!paused && !dragging) {
            flow!.scrollLeft += (AUTO_SPEED * dt) / 1000;
            wrapScroll();
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }
  </script>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .menu-flow,
    .menu-flow.pre-reveal,
    .reveal,
    .reveal.pre-reveal,
    .menu-arrow,
    .btn-primary,
    .site-header,
    .hero-icon,
    .menu-card.has-image,
    .menu-card.has-image::before {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .nav-indicator {
      transition: none !important;
    }
    .menu-flow {
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }
    .menu-card[aria-hidden='true'] {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    max-width: 960px;
    margin: 0 auto;
    padding: 16px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-soft), background-color 0.3s var(--ease-soft);
  }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--border-soft);
  }
  .site-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-mark {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .site-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .site-nav {
    position: relative;
    display: flex;
    gap: 18px;
  }
  .site-nav a {
    color: var(--text-soft);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.25s var(--ease-soft);
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .site-nav a.active {
    color: var(--accent);
    font-weight: 700;
  }
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    transition: transform 0.35s var(--ease-soft), width 0.35s var(--ease-soft), opacity 0.25s var(--ease-soft);
  }
  .nav-indicator.visible {
    opacity: 1;
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .hero {
    position: relative;
    margin: 0 -16px 56px;
    padding: 40px 16px 72px;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    touch-action: pan-y;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-icon {
    display: inline-block;
    font-size: 40px;
    margin-bottom: 8px;
    animation: float 5s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(-4deg);
    }
  }
  .wave-divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 40px;
    display: block;
    z-index: 1;
  }
  .wave-divider path {
    fill: var(--bg);
  }
  h1 {
    margin: 0 0 12px;
    font-size: 28px;
    line-height: 1.45;
    color: var(--text);
    max-width: 16em;
  }
  .hero-underline {
    display: block;
    width: 130px;
    height: 10px;
    margin: 0 0 16px;
  }
  .hero-underline path {
    fill: none;
    stroke: var(--water);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .lead {
    margin: 0 0 24px;
    max-width: 40em;
    color: var(--text-soft);
    line-height: 1.8;
  }
  .btn-primary {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
