---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const DEFAULT_LAT = 39.80249663004133;
const DEFAULT_LON = 141.13550877979688;

const patterns = [
  {
    id: 'locar',
    title: 'Pattern A: LocAR',
    description: 'LocAR.js + three.js。GPSスムージングと高度安定化を備えた実装。',
    href: withBase('/ar/locar'),
  },
  {
    id: 'deviceorientation',
    title: 'Pattern C: DeviceOrientation',
    description: 'コンパス絶対値に依存しない、シルエット位置合わせによる独自実装。',
    href: withBase('/ar/deviceorientation'),
  },
  {
    id: 'arjs',
    title: 'Pattern B: AR.js',
    description: 'A-Frame + AR.js の位置情報AR機能(gps-new-entity-place)を使用。',
    href: withBase('/ar/arjs'),
  },
];

// 体験メニュー。active なものだけリンクを持つ。soon はプレースホルダー(クリック不可)。
const experiences = [
  {
    icon: '📍',
    title: 'ロケーションAR',
    description: '水門の3Dモデルを実物大でその場に重ねて表示します。',
    status: 'active' as const,
    href: '#start',
  },
  {
    icon: '✋',
    title: '手のひらAR',
    description: 'マーカーを使って手のひらサイズで表示します。',
    status: 'soon' as const,
  },
  {
    icon: '🏠',
    title: '点群3D空間(Matterport)',
    description: '現地の点群スキャンをブラウザ上で歩き回れます。',
    status: 'soon' as const,
  },
  {
    icon: '🎥',
    title: '360度動画',
    description: '現地で撮影した360度映像を見られます。',
    status: 'soon' as const,
  },
  {
    icon: '🎮',
    title: '閉伊川3D世界',
    description: 'Unityで構築した閉伊川流域の3D空間を、WebGLでブラウザから探索できます。',
    status: 'soon' as const,
  },
  {
    icon: '🪵',
    title: '流木コンテンツ',
    description: '拾い上げた流木を使ったコンテンツ。ネイティブアプリからWebGLへ移植中です。',
    status: 'soon' as const,
  },
  {
    icon: '🧪',
    title: '開発者実験',
    description: '3つのAR方式を素早く切り替えて実機比較するための開発者向けページ。',
    status: 'active' as const,
    href: withBase('/lab/compare'),
  },
];

const steps = [
  { title: 'カメラ・位置情報・モーションセンサーを許可する', description: '開始時にブラウザが確認を求めます。すべて許可してください。' },
  { title: '体験したい方式と地点を選ぶ', description: '下の「体験メニュー」から選び、必要なら緯度経度を指定します。' },
  { title: 'スマートフォンをかざす', description: '屋外の見通しの良い場所で、画面越しに水門が重なって表示されます。' },
];
---

<BaseLayout title="閉伊川水門プロジェクト">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <header class="site-header">
    <span class="site-title">閉伊川水門プロジェクト</span>
    <nav class="site-nav">
      <a href="#menu">体験メニュー</a>
      <a href="#map">地図</a>
      <a href="#usage">使い方</a>
    </nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <span class="hero-icon" aria-hidden="true">🌊</span>
      <h1>閉伊川水門を、AR・3Dスキャン・映像で体験する</h1>
      <p class="lead">
        岩手県宮古市・閉伊川水門を、現地に行かなくても様々な方法で体験できるプロジェクトです。
        位置情報ARでは、水門の3Dモデルを実物大でその場に重ねて表示します。
      </p>
      <a class="btn-primary" href="#menu">体験メニューを見る</a>

      <svg class="wave-divider" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,20 C300,60 900,-10 1200,30 L1200,60 L0,60 Z" />
      </svg>
    </section>

    <section id="menu" class="menu-section">
      <h2>体験メニュー</h2>
      <div class="menu-grid">
        {
          experiences.map((item) =>
            item.status === 'active' ? (
              <a class="menu-card" href={item.href}>
                <div class="menu-icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="menu-arrow">→</span>
              </a>
            ) : (
              <div class="menu-card soon">
                <div class="menu-icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="badge">近日公開</span>
              </div>
            )
          )
        }
      </div>
    </section>

    <section id="start" class="quick-start">
      <h2>ロケーションARを始める</h2>
      <p class="section-note">
        緯度経度を指定するとその地点にモデルが表示されます。実機がある場所と離れた地点でも配置を確認できます。
      </p>
      <form id="quick-start-form" method="get">
        <div class="field-row">
          <label>
            緯度
            <input type="number" step="any" name="lat" id="lat-input" value={DEFAULT_LAT} required />
          </label>
          <label>
            経度
            <input type="number" step="any" name="lon" id="lon-input" value={DEFAULT_LON} required />
          </label>
          <button type="button" id="use-my-location" class="btn-plain">現在地を使う</button>
        </div>
        <div class="pattern-buttons">
          {
            patterns.map((p) => (
              <button type="submit" formaction={p.href} class="pattern-button">
                <span class="pattern-title">{p.title}</span>
                <span class="pattern-desc">{p.description}</span>
              </button>
            ))
          }
        </div>
      </form>
    </section>

    <section id="map" class="map-section">
      <h2>水門地点マップ</h2>
      <p class="section-note">ピンをクリックすると上のフォームに緯度経度が入力されます。</p>
      <div id="locations-map"></div>
    </section>

    <section id="usage" class="usage-section">
      <h2>使い方</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-number">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="site-footer">
    <a href="https://github.com/Haruto-Sa/ARv2" target="_blank" rel="noopener">GitHub</a>
  </footer>

  <script>
    import { loadLocationCatalog } from '../lib/config/locationConfig';
    import { withBase } from '../lib/paths';

    const latInput = document.getElementById('lat-input') as HTMLInputElement | null;
    const lonInput = document.getElementById('lon-input') as HTMLInputElement | null;

    document.getElementById('use-my-location')?.addEventListener('click', () => {
      if (!navigator.geolocation || !latInput || !lonInput) return;
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          latInput.value = String(pos.coords.latitude);
          lonInput.value = String(pos.coords.longitude);
        },
        (err) => console.warn('現在地の取得に失敗しました', err)
      );
    });

    async function initLocationsMap() {
      const L = (window as any).L;
      const mapEl = document.getElementById('locations-map');
      if (!mapEl || !L) return;

      const map = L.map('locations-map', { zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      try {
        const catalog = await loadLocationCatalog(withBase('/config/locations/index.json'));
        const latlngs: [number, number][] = [];
        for (const loc of catalog) {
          latlngs.push([loc.latitude, loc.longitude]);
          const icon = loc.icon || '📍';
          const marker = L.marker([loc.latitude, loc.longitude]).addTo(map).bindPopup(`${icon} ${loc.name}`);
          marker.on('click', () => {
            if (latInput) latInput.value = String(loc.latitude);
            if (lonInput) lonInput.value = String(loc.longitude);
          });
        }
        if (latlngs.length) {
          map.fitBounds(latlngs, { padding: [20, 20] });
        } else {
          map.setView([39.7021, 141.1544], 14);
        }
      } catch (e) {
        console.warn('ロケーション一覧の読み込みに失敗しました', e);
        map.setView([39.7021, 141.1544], 14);
      }
    }

    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.crossOrigin = '';
    script.onload = () => initLocationsMap();
    document.head.appendChild(script);

    // ヘッダーの背景をスクロール量に応じて濃くする(視認性のための機能的な変化)。
    const header = document.querySelector('.site-header');
    window.addEventListener(
      'scroll',
      () => {
        header?.classList.toggle('scrolled', window.scrollY > 8);
      },
      { passive: true }
    );

    // ナビの現在地ハイライト: 表示中のセクションに対応するリンクへ .active を付ける。
    const navLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]').forEach((a) => {
      navLinks.set(a.getAttribute('href')!.slice(1), a);
    });
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = navLinks.get(entry.target.id);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    navLinks.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    // 体験メニューのカードを、初回表示時だけ軽くフェードイン+スライドさせる。
    const cardObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            cardObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.menu-card').forEach((card) => {
      // pre-reveal はJSがここで付与したときだけ効く(CSS側の既定は常に表示)。
      // JSが動かない/エラーで止まった場合でもカードが消えたままにはならない。
      card.classList.add('pre-reveal');
      cardObserver.observe(card);
    });
  </script>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .menu-card,
    .menu-card.pre-reveal,
    .menu-arrow,
    .btn-primary,
    .site-header,
    .hero-icon {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    max-width: 960px;
    margin: 0 auto;
    padding: 16px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-soft), background-color 0.3s var(--ease-soft);
  }
  .site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--border-soft);
  }
  .site-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .site-nav {
    display: flex;
    gap: 18px;
  }
  .site-nav a {
    color: var(--text-soft);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.25s var(--ease-soft);
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .site-nav a.active {
    color: var(--accent);
    font-weight: 700;
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .hero {
    position: relative;
    margin: 0 -16px 56px;
    padding: 40px 16px 72px;
    background: var(--bg-soft);
  }
  .hero-icon {
    display: inline-block;
    font-size: 40px;
    margin-bottom: 8px;
    animation: float 5s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .wave-divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 40px;
    display: block;
  }
  .wave-divider path {
    fill: var(--bg);
  }
  h1 {
    margin: 0 0 12px;
    font-size: 28px;
    line-height: 1.45;
    color: var(--text);
    max-width: 16em;
  }
  .lead {
    margin: 0 0 24px;
    max-width: 40em;
    color: var(--text-soft);
    line-height: 1.8;
  }
  .btn-primary {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #fff8f3;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent) 70%, transparent);
    transition: background-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
  }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, black);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -8px color-mix(in srgb, var(--accent) 75%, transparent);
  }

  section {
    margin-top: 48px;
    scroll-margin-top: 72px;
  }
  section h2 {
    margin: 0 0 6px;
    font-size: 19px;
    color: var(--text);
  }
  .section-note {
    margin: 0 0 16px;
    font-size: 14px;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .menu-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border-radius: 18px;
    border: none;
    background: var(--surface);
    box-shadow: 0 6px 18px -10px rgba(58, 46, 40, 0.25);
    color: inherit;
    text-decoration: none;
    position: relative;
    transition: opacity 0.6s var(--ease-soft), transform 0.6s var(--ease-soft), box-shadow 0.3s var(--ease-soft);
  }
  /* pre-reveal はJSが付与したときだけ効く。JS未実行時は常に表示された状態が既定。 */
  .menu-card.pre-reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .menu-card.pre-reveal.visible {
    opacity: 1;
    transform: none;
  }
  .menu-card.soon {
    opacity: 0.6;
  }
  .menu-card.soon.pre-reveal:not(.visible) {
    opacity: 0;
  }
  a.menu-card:hover {
    box-shadow: 0 14px 28px -12px rgba(58, 46, 40, 0.32);
    transform: translateY(-3px);
  }
  .menu-icon {
    font-size: 26px;
  }
  .menu-card h3 {
    margin: 0;
    font-size: 15px;
    color: var(--text);
  }
  .menu-card p {
    margin: 0;
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.5;
  }
  .menu-arrow {
    position: absolute;
    right: 16px;
    bottom: 14px;
    color: var(--accent);
    opacity: 0.6;
    font-size: 14px;
    transition: opacity 0.25s var(--ease-soft), transform 0.25s var(--ease-soft);
  }
  a.menu-card:hover .menu-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  .badge {
    align-self: flex-start;
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent2) 18%, var(--surface));
    color: color-mix(in srgb, var(--accent2) 70%, var(--text));
    font-size: 11px;
    font-weight: 700;
  }

  .field-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px;
    margin-bottom: 18px;
  }
  .field-row label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--text-soft);
  }
  .field-row input {
    padding: 9px 12px;
    border-radius: 12px;
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
    width: 14em;
    transition: border-color 0.25s var(--ease-soft);
  }
  .field-row input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .btn-plain {
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.25s var(--ease-soft), background-color 0.25s var(--ease-soft);
  }
  .btn-plain:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  }

  .pattern-buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .pattern-button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 18px;
    border-radius: 18px;
    border: none;
    background: var(--surface);
    box-shadow: 0 6px 18px -10px rgba(58, 46, 40, 0.25);
    color: inherit;
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: box-shadow 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .pattern-button:hover {
    box-shadow: 0 14px 28px -12px rgba(58, 46, 40, 0.32);
    transform: translateY(-3px);
  }
  .pattern-title {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
  }
  .pattern-desc {
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.5;
  }

  #locations-map {
    width: 100%;
    height: 320px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 6px 18px -10px rgba(58, 46, 40, 0.25);
  }

  .steps {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .step-number {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent2);
    color: #fff8f3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
  }
  .steps h3 {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--text);
  }
  .steps p {
    margin: 0;
    font-size: 13px;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .site-footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px 16px 48px;
    font-size: 13px;
  }
  .site-footer a {
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.25s var(--ease-soft);
  }
  .site-footer a:hover {
    color: var(--accent);
  }
</style>
