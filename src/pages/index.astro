---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const DEFAULT_LAT = 39.80249663004133;
const DEFAULT_LON = 141.13550877979688;

const patterns = [
  {
    id: 'locar',
    title: 'Pattern A: LocAR',
    description: 'LocAR.js + three.js。GPSスムージングと高度安定化を備えた実装。',
    href: withBase('/ar/locar'),
  },
  {
    id: 'deviceorientation',
    title: 'Pattern C: DeviceOrientation',
    description: 'コンパス絶対値に依存しない、シルエット位置合わせによる独自実装。',
    href: withBase('/ar/deviceorientation'),
  },
  {
    id: 'arjs',
    title: 'Pattern B: AR.js',
    description: 'A-Frame + AR.js の位置情報AR機能(gps-new-entity-place)を使用。',
    href: withBase('/ar/arjs'),
  },
];

// 体験メニュー。active なものだけリンクを持つ。soon はプレースホルダー(クリック不可)。
const experiences = [
  {
    icon: '📍',
    title: 'ロケーションAR',
    description: '水門の3Dモデルを実物大でその場に重ねて表示します。',
    status: 'active' as const,
    href: '#start',
  },
  {
    icon: '✋',
    title: '手のひらAR',
    description: 'マーカーを使って手のひらサイズで表示します。',
    status: 'soon' as const,
  },
  {
    icon: '🏠',
    title: '点群3D空間(Matterport)',
    description: '現地の点群スキャンをブラウザ上で歩き回れます。',
    status: 'soon' as const,
  },
  {
    icon: '🎥',
    title: '360度動画',
    description: '現地で撮影した360度映像を見られます。',
    status: 'soon' as const,
  },
  {
    icon: '🎮',
    title: '閉伊川3D世界',
    description: 'Unityで構築した閉伊川流域の3D空間を、WebGLでブラウザから探索できます。',
    status: 'active' as const,
    href: withBase('/unity/'),
  },
  {
    icon: '🪵',
    title: '流木コンテンツ',
    description: '拾い上げた流木を使ったコンテンツ。ネイティブアプリからWebGLへ移植中です。',
    status: 'soon' as const,
  },
  {
    icon: '🧪',
    title: '開発者実験',
    description: '3つのAR方式を素早く切り替えて実機比較するための開発者向けページ。',
    status: 'active' as const,
    href: withBase('/lab/compare'),
  },
];

const steps = [
  { title: 'カメラ・位置情報・モーションセンサーを許可する', description: '開始時にブラウザが確認を求めます。すべて許可してください。' },
  { title: '体験したい方式と地点を選ぶ', description: '下の「体験メニュー」から選び、必要なら緯度経度を指定します。' },
  { title: 'スマートフォンをかざす', description: '屋外の見通しの良い場所で、画面越しに水門が重なって表示されます。' },
];
---

<BaseLayout title="閉伊川水門プロジェクト">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
  />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <div class="page">
    <header class="site-header">
      <span class="site-title">閉伊川水門プロジェクト</span>
      <nav class="site-nav">
        <a href="#menu">体験メニュー</a>
        <a href="#map">地図</a>
        <a href="#usage">使い方</a>
      </nav>
    </header>

    <section class="hero">
      <canvas id="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-inner">
        <p class="hero-eyebrow">岩手県宮古市 — 閉伊川</p>
        <h1>閉伊川水門を、<br />AR・3Dスキャン・映像で体験する</h1>
        <p class="lead">
          現地に行かなくても、水門の3Dモデルを実物大でその場に重ねて体験できるプロジェクトです。
        </p>
        <a class="btn-primary" href="#menu">体験メニューを見る</a>
      </div>
      <div class="hero-scroll-cue" aria-hidden="true">
        <span>Scroll</span>
        <svg width="14" height="22" viewBox="0 0 14 22" fill="none"><path d="M7 1v20M1 15l6 6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </section>

    <main class="wrap">
    <section id="menu" class="menu-section">
      <h2>体験メニュー</h2>
      <div class="menu-grid">
        {
          experiences.map((item) =>
            item.status === 'active' ? (
              <a class="menu-card" href={item.href}>
                <div class="menu-icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="menu-arrow">→</span>
              </a>
            ) : (
              <div class="menu-card soon">
                <div class="menu-icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="badge">近日公開</span>
              </div>
            )
          )
        }
      </div>
    </section>

    <section id="start" class="quick-start">
      <h2>ロケーションARを始める</h2>
      <p class="section-note">
        緯度経度を指定するとその地点にモデルが表示されます。実機がある場所と離れた地点でも配置を確認できます。
      </p>
      <form id="quick-start-form" method="get">
        <div class="field-row">
          <label>
            緯度
            <input type="number" step="any" name="lat" id="lat-input" value={DEFAULT_LAT} required />
          </label>
          <label>
            経度
            <input type="number" step="any" name="lon" id="lon-input" value={DEFAULT_LON} required />
          </label>
          <button type="button" id="use-my-location" class="btn-plain">現在地を使う</button>
        </div>
        <div class="pattern-buttons">
          {
            patterns.map((p) => (
              <button type="submit" formaction={p.href} class="pattern-button">
                <span class="pattern-title">{p.title}</span>
                <span class="pattern-desc">{p.description}</span>
              </button>
            ))
          }
        </div>
      </form>
    </section>

    <section id="map" class="map-section">
      <h2>水門地点マップ</h2>
      <p class="section-note">ピンをクリックすると上のフォームに緯度経度が入力されます。</p>
      <div id="locations-map"></div>
    </section>

    <section id="usage" class="usage-section">
      <h2>使い方</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-number">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
    </main>

    <footer class="site-footer">
      <a href="https://github.com/Haruto-Sa/ARv2" target="_blank" rel="noopener">GitHub</a>
    </footer>
  </div>

  <script>
    import { loadLocationCatalog } from '../lib/config/locationConfig';
    import { withBase } from '../lib/paths';
    import { mountWaterHero } from '../lib/hero/waterHero';

    const heroCanvas = document.getElementById('hero-canvas');
    if (heroCanvas instanceof HTMLCanvasElement) {
      const handle = mountWaterHero(heroCanvas);
      if (!handle) {
        document.querySelector('.hero')?.classList.add('no-webgl');
      }
    }

    const latInput = document.getElementById('lat-input') as HTMLInputElement | null;
    const lonInput = document.getElementById('lon-input') as HTMLInputElement | null;

    document.getElementById('use-my-location')?.addEventListener('click', () => {
      if (!navigator.geolocation || !latInput || !lonInput) return;
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          latInput.value = String(pos.coords.latitude);
          lonInput.value = String(pos.coords.longitude);
        },
        (err) => console.warn('現在地の取得に失敗しました', err)
      );
    });

    async function initLocationsMap() {
      const L = (window as any).L;
      const mapEl = document.getElementById('locations-map');
      if (!mapEl || !L) return;

      const map = L.map('locations-map', { zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      try {
        const catalog = await loadLocationCatalog(withBase('/config/locations/index.json'));
        const latlngs: [number, number][] = [];
        for (const loc of catalog) {
          latlngs.push([loc.latitude, loc.longitude]);
          const icon = loc.icon || '📍';
          const marker = L.marker([loc.latitude, loc.longitude]).addTo(map).bindPopup(`${icon} ${loc.name}`);
          marker.on('click', () => {
            if (latInput) latInput.value = String(loc.latitude);
            if (lonInput) lonInput.value = String(loc.longitude);
          });
        }
        if (latlngs.length) {
          map.fitBounds(latlngs, { padding: [20, 20] });
        } else {
          map.setView([39.7021, 141.1544], 14);
        }
      } catch (e) {
        console.warn('ロケーション一覧の読み込みに失敗しました', e);
        map.setView([39.7021, 141.1544], 14);
      }
    }

    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.crossOrigin = '';
    script.onload = () => initLocationsMap();
    document.head.appendChild(script);

    // ヘッダーの背景をスクロール量に応じて濃くする(視認性のための機能的な変化)。
    const header = document.querySelector('.site-header');
    window.addEventListener(
      'scroll',
      () => {
        header?.classList.toggle('scrolled', window.scrollY > 8);
      },
      { passive: true }
    );

    // ナビの現在地ハイライト: 表示中のセクションに対応するリンクへ .active を付ける。
    const navLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]').forEach((a) => {
      navLinks.set(a.getAttribute('href')!.slice(1), a);
    });
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = navLinks.get(entry.target.id);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    navLinks.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    // 体験メニューのカードを、初回表示時だけ軽くフェードイン+スライドさせる。
    const cardObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            cardObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.menu-card').forEach((card) => {
      // pre-reveal はJSがここで付与したときだけ効く(CSS側の既定は常に表示)。
      // JSが動かない/エラーで止まった場合でもカードが消えたままにはならない。
      card.classList.add('pre-reveal');
      cardObserver.observe(card);
    });
  </script>
</BaseLayout>

<style>
  .page {
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --color-bg: #0b0e14;
    --color-hero-bg: #081219;
    --color-surface: rgba(255, 255, 255, 0.03);
    --color-surface-hover: rgba(255, 255, 255, 0.06);
    --color-border: rgba(255, 255, 255, 0.14);
    --color-border-strong: rgba(255, 255, 255, 0.32);
    --color-text: #e6e8ee;
    --color-text-muted: rgba(230, 232, 238, 0.74);
    --color-text-faint: rgba(230, 232, 238, 0.5);
    --color-accent: #6fd8e8;
    --color-accent-dim: rgba(111, 216, 232, 0.45);
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 64px;
    --space-9: 96px;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

    font-family: var(--font-body);
    color: var(--color-text);
  }

  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .menu-card,
    .menu-card.pre-reveal,
    .menu-arrow,
    .btn-primary,
    .site-header,
    .hero-scroll-cue svg {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* -- focus states: キーボード操作時だけアクセントのリングを出す -- */
  .page a:focus-visible,
  .page button:focus-visible,
  .page input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-4);
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .site-header.scrolled {
    background: #0b0e14f2;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--color-border);
  }
  .site-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .site-nav {
    display: flex;
    gap: 22px;
  }
  .site-nav a {
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.01em;
    transition: opacity 0.2s ease;
  }
  .site-nav a:hover {
    opacity: 1;
  }
  .site-nav a.active {
    opacity: 1;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ---------- hero: フルブリードのWebGL水面背景 ---------- */
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: var(--color-hero-bg);
  }
  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-5);
    width: 100%;
    box-sizing: border-box;
  }
  .hero-eyebrow {
    margin: 0 0 var(--space-4);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-shadow: 0 1px 20px rgba(4, 10, 14, 0.8);
  }
  .hero h1 {
    margin: 0 0 var(--space-5);
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.1rem, 1.5rem + 3vw, 4.4rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 30px rgba(4, 10, 14, 0.7);
  }
  .hero .lead {
    margin: 0 0 var(--space-6);
    max-width: 38em;
    font-size: clamp(1rem, 0.93rem + 0.3vw, 1.15rem);
    color: var(--color-text-muted);
    line-height: 1.75;
    text-shadow: 0 1px 20px rgba(4, 10, 14, 0.8);
  }
  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    transform: translateX(-50%);
    color: var(--color-text-faint);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .hero-scroll-cue svg {
    animation: scroll-cue-bounce 2.2s var(--ease-out) infinite;
  }
  @keyframes scroll-cue-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-8);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 13px 24px;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: rgba(8, 14, 19, 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s var(--ease-out);
  }
  .btn-primary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  section {
    margin-top: var(--space-9);
    scroll-margin-top: 80px;
  }
  .wrap > section:first-child {
    margin-top: 0;
  }
  section h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.75rem);
    letter-spacing: -0.005em;
  }
  .section-note {
    margin: 0 0 var(--space-5);
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .menu-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    position: relative;
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out), border-color 0.2s ease,
      background-color 0.2s ease;
  }
  /* pre-reveal はJSが付与したときだけ効く。JS未実行時は常に表示された状態が既定。 */
  .menu-card.pre-reveal {
    opacity: 0;
    transform: translateY(10px);
  }
  .menu-card.pre-reveal.visible {
    opacity: 1;
    transform: none;
  }
  .menu-card.soon {
    opacity: 0.5;
  }
  .menu-card.soon.pre-reveal:not(.visible) {
    opacity: 0;
  }
  /* .pre-reveal.visible (opacity:1) はクラス数で .soon より詳細度が高く、
     そのままだと「近日公開」カードがスクロール出現後に通常カードと
     同じ不透明度に戻ってしまう。明示的に上書きして暗さを保つ。 */
  .menu-card.soon.pre-reveal.visible {
    opacity: 0.5;
  }
  a.menu-card:hover,
  a.menu-card:focus-visible {
    border-color: var(--color-accent-dim);
    background: var(--color-surface-hover);
    transform: translateY(-3px);
  }
  .menu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-1);
    border-radius: 10px;
    background: rgba(111, 216, 232, 0.08);
    font-size: 19px;
  }
  .menu-card h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.002em;
  }
  .menu-card p {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .menu-arrow {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    opacity: 0.45;
    font-size: 14px;
    color: var(--color-accent);
    transition: opacity 0.2s ease, transform 0.2s var(--ease-out);
  }
  a.menu-card:hover .menu-arrow,
  a.menu-card:focus-visible .menu-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  .badge {
    align-self: flex-start;
    margin-top: var(--space-1);
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 11px;
  }

  .field-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .field-row label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .field-row input {
    padding: 9px 11px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.04);
    color: inherit;
    font: inherit;
    font-size: 14px;
    width: 14em;
    transition: border-color 0.2s ease;
  }
  .field-row input:focus-visible {
    border-color: var(--color-accent);
  }
  .btn-plain {
    padding: 9px 15px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
